# ================= 私聊/菜单逻辑 =================

# 辅助函数：延迟删除消息
async def delete_later(message: types.Message, delay: int):
    await asyncio.sleep(delay)
    try:
        await message.delete()
    except:
        pass

# 1. /start 命令 (带强制关注检测)
