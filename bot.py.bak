@dp.callback_query_handler(state=AdminStates.WAITING_FOR_AD_IMAGE_DECISION, user_id=DefaultConfig.ADMIN_ID)
async def ad_image_decision(call: types.CallbackQuery, state: FSMContext):
    msg = None
    if call.data == "ad_img_yes":
        msg = await call.message.answer("请发送图片 (支持多张)：\n\n📸 发送完所有图片后，请点击下方【✅ 上传完毕】按钮。", 
            reply_markup=InlineKeyboardMarkup().add(InlineKeyboardButton("✅ 上传完毕", callback_data="ad_img_done")))
        await state.update_data(ad_images=[])
        await AdminStates.WAITING_FOR_AD_IMAGES.set()
    else:
        msg = await call.message.answer("请输入广告文字内容 (支持HTML/Markdown格式，请直接发送)：")
        await state.update_data(ad_images=[])
        await AdminStates.WAITING_FOR_AD_TEXT.set()
    
    if msg: asyncio.create_task(delete_later(msg, 120))
    await call.answer()

@dp.message_handler(state=AdminStates.WAITING_FOR_AD_IMAGES, content_types=types.ContentType.PHOTO, user_id=DefaultConfig.ADMIN_ID)
async def ad_image_upload(message: types.Message, state: FSMContext):
    async with state.proxy() as data:
        photo_id = message.photo[-1].file_id
        data['ad_images'].append(photo_id)
        # count = len(data['ad_images'])
    
@dp.callback_query_handler(text="ad_img_done", state=AdminStates.WAITING_FOR_AD_IMAGES, user_id=DefaultConfig.ADMIN_ID)
async def ad_image_finish(call: types.CallbackQuery):
    msg = await call.message.answer("图片接收完成！\n\n现在，请输入广告文字内容 (将作为文字消息或图片说明发送)：")
    asyncio.create_task(delete_later(msg, 120))
    await AdminStates.WAITING_FOR_AD_TEXT.set()
    await call.answer()


@dp.message_handler(state=AdminStates.WAITING_FOR_AD_TEXT, content_types=types.ContentType.TEXT, user_id=DefaultConfig.ADMIN_ID)
async def save_ad_text(message: types.Message, state: FSMContext):
    data = await state.get_data()
    # 检查是否是编辑模式
    if data.get('is_edit_mode'):
        ad_id = data.get('edit_ad_id')
        db.update_ad(ad_id, content=message.text)
        await message.reply("✅ 广告内容已更新！")
        # 返回详情页 (这里需要 mock 一个 callback 或者是发新的消息)
        # 简单起见，清除状态，提示用户去列表查看
        await state.finish()
        # 可以尝试发一个带有“返回详情”按钮的消息
        kb = InlineKeyboardMarkup().add(InlineKeyboardButton("⬅️ 返回详情", callback_data=f"view_ad_{ad_id}"))
        new_msg = await message.answer("点击下方按钮返回查看效果：", reply_markup=kb)
        asyncio.create_task(delete_later(new_msg, 120))
        asyncio.create_task(delete_later(message, 120))
        return

    # --- 之前的正常流程 ---
    # 保存内容到 state
    await state.update_data(ad_content=message.text)
    
    msg = await message.answer(
        "📝 **设置广告按钮** (可选)\n\n"
        "请按以下格式发送按钮列表，每行一个按钮：\n"
        "`按钮文字 | 跳转链接`\n\n"
        "例如：\n`联系客服 | https://t.me/xm123`\n`查看详情 | https://google.com`\n\n"
        "如果没有按钮，请回复 `skip` 或 `0` 跳过。",
        parse_mode="Markdown"
    )
    asyncio.create_task(delete_later(msg, 300))
    await AdminStates.WAITING_FOR_AD_BUTTONS.set()
    asyncio.create_task(delete_later(message, 120))

@dp.message_handler(state=AdminStates.WAITING_FOR_AD_BUTTONS, content_types=types.ContentType.TEXT, user_id=DefaultConfig.ADMIN_ID)
async def save_ad_buttons(message: types.Message, state: FSMContext):
    text = message.text.strip()
    buttons = []
    
    if text.lower() not in ['skip', '0', '跳过', 'clean']:
        lines = text.split('\n')
        for line in lines:
            parts = line.split('|')
            if len(parts) >= 2:
                btn_text = parts[0].strip()
                btn_url = parts[1].strip()
                if btn_url.startswith('http') or btn_url.startswith('tg://'):
                    buttons.append({"text": btn_text, "url": btn_url})
    
    # 检查编辑模式
    data = await state.get_data()
    if data.get('is_edit_mode'):
        ad_id = data.get('edit_ad_id')
        db.update_ad(ad_id, buttons=buttons)
        await message.reply("✅ 广告按钮已更新！")
        await state.finish()
        kb = InlineKeyboardMarkup().add(InlineKeyboardButton("⬅️ 返回详情", callback_data=f"view_ad_{ad_id}"))
        new_msg = await message.answer("点击下方按钮返回查看效果：", reply_markup=kb)
        asyncio.create_task(delete_later(new_msg, 120))
        asyncio.create_task(delete_later(message, 120))
        return

    await state.update_data(ad_buttons=buttons)
    
    msg = await message.answer("🏷 **设置广告备注/标题**\n\n请输入一个简短的标题方便管理（例如：`早安语`、`轮播广告A`）：")
    asyncio.create_task(delete_later(msg, 300))
    await AdminStates.WAITING_FOR_AD_TITLE.set()
    asyncio.create_task(delete_later(message, 120))

@dp.message_handler(state=AdminStates.WAITING_FOR_AD_TITLE, content_types=types.ContentType.TEXT, user_id=DefaultConfig.ADMIN_ID)
async def save_ad_title(message: types.Message, state: FSMContext):
    title = message.text.strip()
    
    data = await state.get_data()
    if data.get('is_edit_mode'):
        ad_id = data.get('edit_ad_id')
        db.update_ad(ad_id, title=title)
        await message.reply("✅ 广告标题已更新！")
        await state.finish()
        kb = InlineKeyboardMarkup().add(InlineKeyboardButton("⬅️ 返回详情", callback_data=f"view_ad_{ad_id}"))
        new_msg = await message.answer("点击下方按钮返回查看效果：", reply_markup=kb)
        asyncio.create_task(delete_later(new_msg, 120))
        asyncio.create_task(delete_later(message, 120))
        return

    async with state.proxy() as data:
        images = data.get('ad_images', [])
        content = data.get('ad_content', '')
        buttons = data.get('ad_buttons', [])
    
    msg_type = "text"
    if images:
        msg_type = "album" if len(images) > 1 else "photo"
        
    db.add_ad(content, images, msg_type, title, buttons)
    
    img_count = len(images)
    btn_count = len(buttons)
    msg = await message.reply(f"✅ 新广告 **{title}** 已添加！\n包含 {img_count} 张图片，{btn_count} 个按钮。")
    asyncio.create_task(delete_later(msg, 120))
    asyncio.create_task(delete_later(message, 120))
    await state.finish()

# --- 广告详情与编辑逻辑 ---
@dp.callback_query_handler(text_startswith="view_ad_", user_id=DefaultConfig.ADMIN_ID)
async def view_ad_handler(call: types.CallbackQuery):
    ad_id = int(call.data.split("_")[-1])
    ad = db.get_ad(ad_id)
    if not ad:
        await call.answer("❌ 广告不存在或已被删除", show_alert=True)
        # 刷新列表
        await admin_menu_handler(call, None) # 这种调用可能不合适，最好手动刷新或者 back
        return

    title = ad.get('title') or "未命名广告"
    content = ad.get('content') or "[无文本]"
    btn_count = len(ad.get('buttons', []))
    img_count = len(ad.get('images', []))
    
    text = (
        f"📺 **广告详情**\n\n"
        f"🏷 **标题**: {title}\n"
        f"📝 **内容摘要**: {content[:50]}...\n"
        f"🖼 **图片数**: {img_count}\n"
        f"🔘 **按钮数**: {btn_count}\n\n"
        "请选择操作："
    )
    
    kb = InlineKeyboardMarkup(row_width=2)
    kb.add(InlineKeyboardButton("✏️ 修改内容", callback_data=f"edit_ad_content_{ad_id}"))
    kb.add(InlineKeyboardButton("🔘 修改按钮", callback_data=f"edit_ad_btn_{ad_id}"))
    kb.add(InlineKeyboardButton("🏷 修改标题", callback_data=f"edit_ad_title_{ad_id}"))
    kb.add(InlineKeyboardButton("🖼 重传图片", callback_data=f"edit_ad_img_{ad_id}"))
    kb.add(InlineKeyboardButton("🗑 删除广告", callback_data=f"del_random_ad_{ad_id}"))
    kb.add(InlineKeyboardButton("⬅️ 返回列表", callback_data="admin_ad"))
    
    await call.message.edit_text(text, reply_markup=kb)
    await call.answer()

# --- 编辑广告的具体实现 ---
# 通用：先保存 Ad ID 到 state，然后跳转对应输入流程

@dp.callback_query_handler(text_startswith="edit_ad_", user_id=DefaultConfig.ADMIN_ID)
async def edit_ad_start(call: types.CallbackQuery, state: FSMContext):
    action, _, ad_id = call.data.rpartition('_')
    # action e.g. "edit_ad_content", "edit_ad_title"
    ad_id = int(ad_id)
    
    await state.update_data(edit_ad_id=ad_id)
    
    msg = None
    if "content" in action:
        msg = await call.message.answer("请输入新的 **广告内容**：")
        await AdminStates.WAITING_FOR_AD_TEXT.set() # 复用 TEXT 状态，但在 handler 里需要区分是否是编辑模式
        # 这里为了简单，我们使用新的 State 或者复用但加标记。
        # 最好是专门的 Edit State 或者在 FSM data 里标记 'is_edit'=True
        await state.update_data(is_edit_mode=True, edit_field='content')

    elif "title" in action:
        msg = await call.message.answer("请输入新的 **标题**：")
        await AdminStates.WAITING_FOR_AD_TITLE.set()
        await state.update_data(is_edit_mode=True, edit_field='title')
        
    elif "btn" in action:
        msg = await call.message.answer(
            "请输入新的 **按钮列表** (格式: 文字 | 链接，一行一个)：\n回复 `clean` 清空按钮。"
        )
        await AdminStates.WAITING_FOR_AD_BUTTONS.set()
        await state.update_data(is_edit_mode=True, edit_field='buttons')

    if msg: asyncio.create_task(delete_later(msg, 120))
    await call.answer()

# 我们需要修改之前的 save_ad_text, save_ad_buttons, save_ad_title 等 handler
# 让它们能够处理 "编辑模式"


@dp.callback_query_handler(text_startswith="del_random_ad_", user_id=DefaultConfig.ADMIN_ID)
async def del_random_ad_handler(call: types.CallbackQuery):
    ad_id = int(call.data.split("_")[-1])
    db.delete_ad(ad_id)
    await call.answer("已删除广告")
    # 刷新界面
    interval = db.get_setting("AD_INTERVAL", DefaultConfig.AD_INTERVAL)
    ads = db.get_all_ads()
    text = f"🕒 **定时广告配置**\n推送间隔: {interval}秒\n当前广告数: {len(ads)}\n\n⚠️ 系统将随机抽取一条发送。"
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton("➕ 添加新广告", callback_data="add_random_ad"))
    kb.add(InlineKeyboardButton("⏱ 修改间隔", callback_data="edit_ad_interval"))
    for ad in ads:
        preview = (ad['content'][:10] + '...') if ad['content'] else "[纯图片]"
        kb.add(InlineKeyboardButton(f"🗑 删除: {preview}", callback_data=f"del_random_ad_{ad['id']}"))
    kb.add(InlineKeyboardButton("⬅️ 返回", callback_data="admin_back"))
    await call.message.edit_text(text, reply_markup=kb)


@dp.callback_query_handler(text="edit_ad_interval", user_id=DefaultConfig.ADMIN_ID)
async def edit_ad_interval(call: types.CallbackQuery):
    await call.message.answer("请输入新的广告推送间隔（秒）：")
    await AdminStates.WAITING_FOR_AD_INTERVAL.set()
    await call.answer()

@dp.message_handler(state=AdminStates.WAITING_FOR_AD_INTERVAL, user_id=DefaultConfig.ADMIN_ID)
async def save_ad_interval(message: types.Message, state: FSMContext):
    if not message.text.isdigit():
        await message.reply("❌ 请输入数字")
        return
    db.set_setting("AD_INTERVAL", int(message.text))
    await message.reply("✅ 广告间隔已更新")
    await state.finish()




# ================= Start Menu Wizard (NEW) =================
@dp.callback_query_handler(text="add_start_item", user_id=DefaultConfig.ADMIN_ID)
async def add_start_item_start(call: types.CallbackQuery):
    await call.message.answer("请输入菜单按钮显示的 **文字**：")
    await AdminStates.WAITING_FOR_START_TEXT.set()
    await call.answer()

@dp.message_handler(state=AdminStates.WAITING_FOR_START_TEXT, content_types=types.ContentType.TEXT, user_id=DefaultConfig.ADMIN_ID)
async def start_item_text(message: types.Message, state: FSMContext):
    await state.update_data(menu_text=message.text)
    
    kb = InlineKeyboardMarkup(row_width=3)
    kb.add(
        InlineKeyboardButton("🔗 跳转链接", callback_data="type_link"),
        InlineKeyboardButton("📝 回复图文", callback_data="type_reply"),
        InlineKeyboardButton("🚨 触发举报", callback_data="type_report")
    )
    await message.reply("请选择此按钮的功能类型：", reply_markup=kb)
    await AdminStates.WAITING_FOR_START_TYPE.set()

@dp.callback_query_handler(state=AdminStates.WAITING_FOR_START_TYPE, user_id=DefaultConfig.ADMIN_ID)
async def start_item_type(call: types.CallbackQuery, state: FSMContext):
    action_type = call.data.replace("type_", "")
    await state.update_data(menu_type=action_type)
    
    if action_type == "link":
        await call.message.answer("请输入跳转的 **URL链接** (必须以 http/https 开头)：")
        await AdminStates.WAITING_FOR_START_VALUE.set()
    elif action_type == "reply":
        await call.message.answer("请输入 **回复内容** (支持直接发送文字或一张图片)：\n注意：如果发送图片，文字将作为图片说明。")
        await AdminStates.WAITING_FOR_START_VALUE.set()
    elif action_type == "report":
        # 举报类型不需要额外值，直接保存
        data = await state.get_data()
        db.add_start_menu_item(data['menu_text'], "report", None, None)
        await call.message.answer(f"✅ 已添加按钮: [{data['menu_text']}] -> 触发举报")
        await state.finish()
    
    await call.answer()

@dp.message_handler(state=AdminStates.WAITING_FOR_START_VALUE, content_types=[types.ContentType.TEXT, types.ContentType.PHOTO], user_id=DefaultConfig.ADMIN_ID)
async def start_item_value(message: types.Message, state: FSMContext):
    data = await state.get_data()
    text = data['menu_text']
    atype = data['menu_type']
    
    action_value = None
    media_id = None
    
    if atype == "link":
        if not message.text.startswith("http"):
            await message.reply("❌ URL必须以http开头，请重新输入：")
            return
        action_value = message.text
        
    elif atype == "reply":
        if message.photo:
            media_id = message.photo[-1].file_id
            action_value = message.caption  # 图片的文字说明
        else:
            action_value = message.text

    db.add_start_menu_item(text, atype, action_value, media_id)
    await message.reply(f"✅ 已添加按钮: [{text}]")
    await state.finish()

@dp.callback_query_handler(text_startswith="del_start_item_", user_id=DefaultConfig.ADMIN_ID)
async def del_start_item(call: types.CallbackQuery):
    item_id = int(call.data.split("_")[-1])
    db.delete_start_menu_item(item_id)
    await call.answer("已删除菜单项")
    
    # 刷新
    items = db.get_start_menu_items()
    text = f"🚀 **Start 菜单配置**\n当前菜单项数: {len(items)}\n\n点击下方按钮可以删除，或添加新菜单项。"
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton("➕ 添加新菜单项", callback_data="add_start_item"))
    for item in items:
        type_icon = "🔗" if item['type'] == 'link' else ("🖼" if item['media'] else "📝")
        kb.add(InlineKeyboardButton(f"🗑 {type_icon} {item['text']}", callback_data=f"del_start_item_{item['id']}"))
    kb.add(InlineKeyboardButton("⬅️ 返回", callback_data="admin_back"))
    await call.message.edit_text(text, reply_markup=kb)

# ================= 系统管理命令 (Bot Owner) =================
@dp.message_handler(commands=['addbtn'], user_id=DefaultConfig.ADMIN_ID)
async def cmd_add_btn(message: types.Message):
    try:
        args = message.get_args().split()
        if len(args) < 2: return
        db.add_button(args[0], args[1])
        await message.reply("✅ 添加成功 (按钮菜单已停用)")
    except: pass

@dp.message_handler(commands=['delbtn'], user_id=DefaultConfig.ADMIN_ID)
async def cmd_del_btn(message: types.Message):
    try:
        db.delete_button(int(message.get_args()))
        await message.reply("🗑 删除成功 (按钮菜单已停用)")
    except: pass

@dp.message_handler(commands=['broadcast'], user_id=DefaultConfig.ADMIN_ID)
async def cmd_broadcast(message: types.Message):
    users = db.get_all_users()
    count = 0
    for uid in users:
        try: 
            await bot.send_message(uid, f"📢 {message.get_args()}")
            count += 1
            await asyncio.sleep(0.05) # 简单防刷屏限制
        except: pass
    await message.reply(f"✅ 发送完成，成功送达: {count} 人")

# ================= 数据备份与恢复 (NEW) =================
@dp.message_handler(commands=['export'], user_id=DefaultConfig.ADMIN_ID)
async def cmd_export_db(message: types.Message):
    """导出数据库备份"""
    try:
        file_path = DefaultConfig.DB_NAME
        if os.path.exists(file_path):
            await message.reply_document(types.InputFile(file_path), caption=f"📅 备份时间: {time.strftime('%Y-%m-%d %H:%M:%S')}")
        else:
            await message.reply("❌ 数据库文件不存在")
    except Exception as e:
        await message.reply(f"❌ 导出失败: {e}")

@dp.message_handler(content_types=types.ContentType.DOCUMENT, user_id=DefaultConfig.ADMIN_ID)
async def cmd_import_db(message: types.Message):
    """导入数据库备份 (需在Caption中写 /import 或回复消息)"""
    is_import_cmd = (message.caption and message.caption.startswith('/import'))
    
    if not is_import_cmd:
        return

    try:
        # 下载文件
        doc = message.document
        if not doc.file_name.endswith('.db') and not doc.file_name.endswith('.sqlite'):
            await message.reply("⚠️ 请上传 .db 或 .sqlite 后缀的数据库文件")
            return

        await message.reply("⏳ 正在恢复数据...")
        
        # 下载到临时文件
        temp_file = doc.file_name + ".new"
        await doc.download(destination_file=temp_file)
        
        # 验证文件是否为SQLite
        try:
            conn = sqlite3.connect(temp_file)
            cursor = conn.cursor()
            cursor.execute("SELECT name FROM sqlite_master WHERE type='table';")
            tables = cursor.fetchall()
            conn.close()
            
            if not tables:
                await message.reply("❌ 无效的数据库文件 (无表)")
                os.remove(temp_file)
                return
        except Exception as e:
            await message.reply(f"❌ 数据库文件损坏: {e}")
            if os.path.exists(temp_file): os.remove(temp_file)
            return

        # 替换文件
        db_path = DefaultConfig.DB_NAME
        
        # 1. 关闭现有连接
        db.reload() # 此时会关闭旧连接
        
        # 2. 替换
        if os.path.exists(db_path):
            os.remove(db_path)
        os.rename(temp_file, db_path)
        
        # 3. 重新加载连接
        db.reload()
        
        await message.reply("✅ 数据恢复成功！\n配置和用户数据已回滚至备份状态。")
        
    except Exception as e:
        await message.reply(f"❌ 恢复失败: {e}")

# 定时任务
async def scheduled_ad_task():
    while True:
        # 动态获取间隔
        interval = db.get_setting("AD_INTERVAL", DefaultConfig.AD_INTERVAL)
        await asyncio.sleep(interval)
        
        # 获取所有广告并随机取一条
        ads = db.get_all_ads()
        if not ads:
            continue
            
        ad = random.choice(ads)
        content = ad['content']
        images = ad['images']
        buttons = ad.get('buttons', [])
        
        # 构造按钮
        kb = None
        if buttons:
            kb = InlineKeyboardMarkup(row_width=1)
            for btn in buttons:
                kb.add(InlineKeyboardButton(btn['text'], url=btn['url']))

        # 获取活跃群组
        groups = db.get_all_groups()
        
        for chat_id in groups:
            try:
                if images:
                    if len(images) == 1:
                        # 单张图片
                        await bot.send_photo(chat_id, images[0], caption=content, reply_markup=kb)
                    else:
                        # 多张图片 (MediaGroup)
                        media = types.MediaGroup()
                        for i, img_id in enumerate(images):
                            if i == 0:
                                media.attach_photo(img_id, caption=content)
                            else:
                                media.attach_photo(img_id)
                        await bot.send_media_group(chat_id, media=media)
                        if kb:
                            await bot.send_message(chat_id, "👇 点击下方按钮了解更多：", reply_markup=kb)
                else:
                    # 纯文本
                    if content:
                        await bot.send_message(chat_id, content, reply_markup=kb)
            except Exception as e:
                pass
            
            await asyncio.sleep(0.5)

if __name__ == '__main__':
    loop = asyncio.get_event_loop()
    loop.create_task(scheduled_ad_task())
    executor.start_polling(dp, skip_updates=True)