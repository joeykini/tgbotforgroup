                name_link = "这位鹅友"
            else:
                name_link = f"[{member.full_name}](tg://user?id={member.id})"
            
            text = (
                "欢迎使用麻辣鹅系统\n"
                f"    {name_link} ，鹅友，您好!\n"
                f"🤗欢迎来到[麻辣鹅圈子]({link_group})，立即开始你的麻辣探索之旅吧；\n"
                f"    小鹅均为已验证资源!对眼有感即可冲，放心\"旅途\"，勿需多虑!\n"
