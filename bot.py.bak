@dp.callback_query_handler(text="add_random_ad", user_id=DefaultConfig.ADMIN_ID)
async def add_random_ad_start(call: types.CallbackQuery, state: FSMContext):
    kb = InlineKeyboardMarkup().add(
        InlineKeyboardButton("🖼 是，我要上传图片", callback_data="ad_img_yes"),
        InlineKeyboardButton("📝 否，纯文字广告", callback_data="ad_img_no")
    )
    await call.message.answer("是否需要为广告添加图片？\n(支持多张图片，就像发送普通图文一样)", reply_markup=kb)
